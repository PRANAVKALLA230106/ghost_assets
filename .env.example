# Copy to .env (never commit .env)
# Any OpenAI-compatible endpoint; we use Groq's free tier.
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
LLM_MODEL=openai/gpt-oss-20b       # text extraction (JSON mode)
VISION_MODEL=qwen/qwen3.8-27b      # calls with images (photo transcription); defaults to LLM_MODEL
AGENT_MODEL=openai/gpt-oss-120b    # agent tool calls; defaults to LLM_MODEL
REASONING_EFFORT=low            # gpt-oss only: low cuts hidden reasoning tokens (free-tier daily quota)

FAKE_EVENTS=0                  # 1 = /run replays data/ramesh/fake_events.jsonl (frontend dev)
DEMO_DELAY=0                    # seconds between emitted events, e.g. 0.15 for a cached demo run
SCRIPTED=0                      # 1 = agent follows backend/scripted_trace.json (stage fallback)
